% pact-classic.sty
% The original modern bold/Huge textbook treatment for "The Pact",
% retired in favor of the austere statute-book style now used by
% pact.sty. Kept for reference and comparison; see main-classic.tex.
% Hand-rolled to avoid dependencies not present on this system (no
% geometry, titlesec, enumitem, fancyhdr, xcolor, microtype).
% Only calc, longtable, lmodern, hyperref are assumed available.
%
% Font note: mathpazo (Palatino) was tried first but this TeXLive install has
% the psnfss .sty/.fd wrapper without the actual URW Palladio Type1/TFM font
% files, and Metafont (mf) isn't installed to generate substitutes either --
% pdflatex fails with "Font ... not loadable" and produces no PDF. lmodern's
% font files are actually present, so it's used instead. Revisit if the
% missing font packages are ever installed (see README's Toolchain notes).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pact-classic}[2026/09/01 Formatting for The Pact (classic style)]

\RequirePackage{calc}
\RequirePackage{lmodern}
\RequirePackage{longtable}

% ---------------------------------------------------------------------------
% Page geometry (manual, in place of the geometry package)
% Trade-book trim size, twoside, with binding-aware margins.
% ---------------------------------------------------------------------------
\setlength{\paperwidth}{6in}
\setlength{\paperheight}{9in}
\pdfpagewidth=\paperwidth
\pdfpageheight=\paperheight

\setlength{\textwidth}{4.4in}
\setlength{\textheight}{7in}
\setlength{\topmargin}{0.15in}
\setlength{\headheight}{14pt}
\setlength{\headsep}{0.25in}
\setlength{\footskip}{0.4in}
\setlength{\oddsidemargin}{0.55in}
\setlength{\evensidemargin}{0.35in}
\setlength{\marginparwidth}{0pt}
\setlength{\marginparsep}{0pt}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}

% ---------------------------------------------------------------------------
% Sectioning: Articles (chapters) in Arabic numerals, matching the Article/
% Section numbering convention seen on the Apple TV+ show's "Pact" prop
% (numbered Articles, e.g. "Article 9", cross-referencing numbered Sections);
% lettered/roman clause lists in place of enumitem.
% ---------------------------------------------------------------------------
\renewcommand{\chaptername}{Article}
\renewcommand{\thechapter}{\arabic{chapter}}

\makeatletter
\renewcommand{\thesection}{\arabic{section}}
\renewcommand{\@seccntformat}[1]{Section \csname the#1\endcsname.\ }
\makeatother

% Clause lists: (a), (b), (c) ... and nested (i), (ii), (iii) ...
\renewcommand{\theenumi}{\alph{enumi}}
\renewcommand{\labelenumi}{(\theenumi)}
\renewcommand{\theenumii}{\roman{enumii}}
\renewcommand{\labelenumii}{(\theenumii)}

\newenvironment{clauses}{\begin{enumerate}}{\end{enumerate}}
\newenvironment{subclauses}{\begin{enumerate}}{\end{enumerate}}

% A short epigraph-style block for article openings (no framed/xcolor needed).
\newcommand{\articlenote}[1]{%
  \begingroup
  \small\itshape
  \noindent #1\par
  \endgroup
  \vspace{0.6\baselineskip}
}

\newenvironment{definitionlist}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{1.4em}
    \setlength{\labelwidth}{1.2em}
    \setlength{\labelsep}{0.4em}
    \setlength{\itemsep}{0.3\baselineskip}
    \setlength{\parsep}{0pt}
  }
}{\end{list}}
\newcommand{\termitem}[1]{\item[]\textbf{#1.}\ }

\pagestyle{headings}

% Running headers: book.cls's default `headings` style repeats the full
% chapter/section title in the header, which overflows \textwidth for our
% longer Article/Section titles (overfull \hbox warnings). Keep headers to
% just "ARTICLE N" / "SECTION N" instead -- shorter, guaranteed to fit, and
% consistent with the sober/minimal-ornament design goal.
\makeatletter
\renewcommand{\chaptermark}[1]{\markboth{\MakeUppercase{\@chapapp\ \thechapter}}{}}
\renewcommand{\sectionmark}[1]{\markright{\MakeUppercase{Section\ \thesection}}}
\makeatother
