% pact.sty
% Formatting for "The Pact" -- an austere, statute-book treatment
% (centered rule-bound chapter openings, small-caps section headings).
% Hand-rolled to avoid dependencies not present on this system (no
% geometry, titlesec, enumitem, fancyhdr, xcolor, microtype). Only calc,
% longtable, lmodern, hyperref are assumed available.
%
% Font note: mathpazo (Palatino) was tried first but this TeXLive install
% lacks the actual URW Palladio Type1/TFM font files, and Metafont isn't
% installed to generate substitutes either -- lmodern's font files are
% actually present, so it's used instead.
%
% The earlier modern bold/Huge textbook treatment is retired but kept for
% reference as pact-classic.sty; see main-classic.tex.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pact}[2026/09/04 Formatting for The Pact]

\RequirePackage{calc}
\RequirePackage{lmodern}
\RequirePackage{longtable}

% ---------------------------------------------------------------------------
% Page geometry (unchanged from pact.sty)
% ---------------------------------------------------------------------------
\setlength{\paperwidth}{6in}
\setlength{\paperheight}{9in}
\pdfpagewidth=\paperwidth
\pdfpageheight=\paperheight

\setlength{\textwidth}{4.4in}
\setlength{\textheight}{7in}
\setlength{\headheight}{14pt}
\setlength{\headsep}{0.25in}
\setlength{\footskip}{0.4in}
% The text block is centred on the page, horizontally and vertically. The book
% is read on a screen, not bound, so there is no gutter to favour and nothing
% is mirrored. LaTeX measures all three of these from a 1in origin.
%
% Across: 6in of paper less 4.4in of text leaves 0.8in a side.
% Down:   the head (14pt) plus \headsep (0.25in) plus \textheight (7in) is
%         7.4437in, so 9in of paper leaves 0.7781in above and below.
\setlength{\oddsidemargin}{-0.2in}
\setlength{\evensidemargin}{-0.2in}
\setlength{\topmargin}{-0.2219in}
\setlength{\marginparwidth}{0pt}
\setlength{\marginparsep}{0pt}
\setlength{\parindent}{1.2em}
\setlength{\parskip}{0pt}

% ---------------------------------------------------------------------------
% Sectioning: Articles (chapters) in Arabic numerals, Sections likewise --
% same numbering convention as pact.sty (matches the show's Pact prop).
% ---------------------------------------------------------------------------
\renewcommand{\chaptername}{Article}
\renewcommand{\thechapter}{\arabic{chapter}}

\makeatletter
\renewcommand{\thesection}{\arabic{section}}
\renewcommand{\@seccntformat}[1]{Section \csname the#1\endcsname.\ }
\makeatother

\renewcommand{\theenumi}{\alph{enumi}}
\renewcommand{\labelenumi}{(\theenumi)}
\renewcommand{\theenumii}{\roman{enumii}}
\renewcommand{\labelenumii}{(\theenumii)}

\newenvironment{clauses}{\begin{enumerate}}{\end{enumerate}}
\newenvironment{subclauses}{\begin{enumerate}}{\end{enumerate}}

% ---------------------------------------------------------------------------
% Chapter (Article) openings: centered, rule-bound, small caps -- a statute-
% book treatment in place of book.cls's default Huge bold left-aligned head.
% ---------------------------------------------------------------------------
\makeatletter
\def\@makechapterhead#1{%
  \vspace*{40\p@}%
  {\parindent\z@\centering\normalfont
    \ifnum\c@secnumdepth>\m@ne
      \if@mainmatter
        {\normalsize\scshape \@chapapp\ \thechapter\par}%
        \vskip 8\p@
        \rule{1.6in}{0.4pt}%
        \vskip 14\p@
      \fi
    \fi
    \interlinepenalty\@M
    {\Large\scshape #1\par}%
    \vskip 6\p@
    \rule{1.6in}{0.4pt}%
    \vskip 30\p@
  }}
\def\@makeschapterhead#1{%
  \vspace*{40\p@}%
  {\parindent\z@\centering\normalfont
    \interlinepenalty\@M
    {\Large\scshape #1\par}%
    \vskip 6\p@
    \rule{1.6in}{0.4pt}%
    \vskip 30\p@
  }}
\makeatother

% Section headings: small caps, centered, run at normal size rather than
% the default \Large\bfseries -- a quieter, statute-like register.
\makeatletter
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {3ex \@plus 1ex \@minus .2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\scshape}}
\makeatother

% ---------------------------------------------------------------------------
% Cross-references.
%
% The Pact cites itself in prose ("under Article 17", "under Article 13,
% Section 6"), never with a bare section mark -- see STYLE.md. These macros
% print exactly that prose while driving the numbers off \label/\ref, so a
% renumbering can no longer silently break a citation: LaTeX reports every
% reference it cannot resolve. Labels are keyed to meaning, not to number
% (\label{art:crimes}, \label{sec:crimes:offenses-among-the-gravest}).
%
%   \artref{art:crimes}                        -> Article 17
%   \secref{art:labor}{sec:labor:critical-roles-and-order-adjacent-trades}
%                                              -> Article 13, Section 6
%   \secrefhere{sec:crimes:form-of-a-grace}    -> Section 6   (same Article)
%
% The ~ keeps "Article" and its number on one line.
\newcommand{\artref}[1]{Article~\ref{#1}}
\newcommand{\secref}[2]{Article~\ref{#1}, Section~\ref{#2}}
\newcommand{\secrefhere}[1]{Section~\ref{#1}}
% Bare numbers, for the two places that cite several sections at once
% ("Sections 1, 3, 5, or 6") and so cannot use the forms above.
\newcommand{\artnum}[1]{\ref{#1}}
\newcommand{\secnum}[1]{\ref{#1}}

\newcommand{\articlenote}[1]{%
  \begingroup
  \small\itshape
  \noindent #1\par
  \endgroup
  \vspace{0.6\baselineskip}
}

\newenvironment{definitionlist}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{1.4em}
    \setlength{\labelwidth}{1.2em}
    \setlength{\labelsep}{0.4em}
    \setlength{\itemsep}{0.3\baselineskip}
    \setlength{\parsep}{0pt}
  }
}{\end{list}}
\newcommand{\termitem}[1]{\item[]\textbf{#1.}\ }

\renewcommand{\contentsname}{Table of Articles and Sections}
% Running heads at \footnotesize: an Article's whole title will not sit on a
% 4.4in measure at text size, and a quieter head suits the register besides.
% Book.cls's own \ps@headings is replaced rather than patched so that the
% \chaptermark and \sectionmark set below are not overwritten by it.
\makeatletter
% The foot carries the binder's mark on the rectos it belongs on and the
% pressman's figure where he left one; most feet are empty. Both are set
% in the impression block below.
\def\ps@headings{%
  \def\@oddfoot{\rlap{\pact@signature}\hfil\llap{\pact@pressfigure}}%
  \def\@evenfoot{\rlap{\pact@pressfigure}\hfil}%
  \def\@evenhead{{\footnotesize\folio}\hfil{\footnotesize\slshape\leftmark}}%
  \def\@oddhead{{\footnotesize\slshape\rightmark}\hfil{\footnotesize\folio}}%
  \let\@mkboth\markboth}
\makeatother

\pagestyle{headings}

\makeatletter
\renewcommand{\chaptermark}[1]{\markboth{\scshape\@chapapp\ \thechapter}{}}
\renewcommand{\sectionmark}[1]{\markright{\scshape Section\ \thesection}}
\makeatother

% ---------------------------------------------------------------------------
% Running heads: the verso carries the Article and its title, the recto the
% Section. A reader flipping the book lands somewhere nameable.
% ---------------------------------------------------------------------------
%
% A second hand. One Article in this book was set by another compositor, who
% abbreviated in the running heads where the first spelt out and who left the
% point off his section heads. It is that Article throughout and not a page
% of any other, which is how a gathering set by one man reads.
\makeatletter
\def\pact@secondhand{14}
\renewcommand{\chaptermark}[1]{%
  \ifnum\c@chapter=\pact@secondhand\relax
    \markboth{{\scshape Art.\ \thechapter}\ \textperiodcentered\ {\scshape #1}}{}%
  \else
    \markboth{{\scshape\@chapapp\ \thechapter}\ \textperiodcentered\ {\scshape #1}}{}%
  \fi}
\renewcommand{\sectionmark}[1]{%
  \ifnum\c@chapter=\pact@secondhand\relax
    \markright{\scshape Sect.\ \thesection}%
  \else
    \markright{\scshape Section\ \thesection}%
  \fi}
\renewcommand{\@seccntformat}[1]{%
  Section \csname the#1\endcsname
  \ifnum\c@chapter=\pact@secondhand\relax\else.\fi\ }
\makeatother

% ---------------------------------------------------------------------------
% The artifact layer.
%
% Articles 21 and 23 describe how every copy of this Pact is made, marked,
% placed, compared, corrected and stamped. These macros let the printed book
% obey its own Articles on its own body. See AUTHENTICITY-2026-10-08.md.
%
% Deliberately NOT simulated: foxing, stains, torn edges, aged paper. Wear is
% what weather did; this layer is only what an office did.
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}

% \stamp[angle]{wording} -- a double-ruled small-caps block, set slightly out
% of true, in the manner of an impression from one of the seal-stamps cut by
% Mechanical to the pattern the Judge keeps (Article 21). Office wording
% distinguishes one stamp from another; never ornament.
\newcommand{\stamp}[2][3]{%
  \rotatebox{#1}{%
    \setlength{\fboxrule}{0.7pt}%
    \setlength{\fboxsep}{4pt}%
    \fbox{\vbox{\hrule\vskip2.5pt
      \hbox{\ \normalfont\footnotesize\scshape\spaceskip=0.45em #2\ }%
      \vskip2.5pt\hrule}}}}

% \stampline{wording} -- the same, centred on its own line with air around it.
\newcommand{\stampline}[2][3]{%
  \par\vspace{10pt}\noindent\hfill\stamp[#1]{#2}\hfill\null\par\vspace{10pt}}

% \fillrule{width} -- a ruled blank to be completed by hand. A blank on a
% printed form is the cheapest proof that the form was ever in use.
\newcommand{\fillrule}[1]{\leavevmode\hbox to #1{\hrulefill}}

% \corr{superseded}{true} -- a correction carried into this copy against the
% master copy, as Article 23, Section 8 requires. The superseded word is
% struck, not removed, and the true word follows in the Clerk's hand. Used
% exactly once in the body; see the Notice of a Correction in the front
% matter. Do not multiply it.
\newcommand{\corr}[2]{%
  \leavevmode
  \hbox{\rlap{\raisebox{0.42ex}{\rule{\widthof{#1}}{0.4pt}}}#1}%
  \nobreak\ {\ttfamily\footnotesize #2}%
  \nobreak\,{\ttfamily\scriptsize corr.}}

% ---------------------------------------------------------------------------
% The impression.
%
% The layer above is what an office did to this copy. This is what the press
% did to it, and the two date from different days. A copy of this Pact cannot
% grow visibly old: Article 21, Section 7 has every copy compared against the
% archive copy once yearly and replaced within the season if it is found
% damaged or wanting, so wear never accumulates on a copy that is still in
% its place. What a copy can carry is everything that went wrong in the
% making, because no comparison of one printed copy against another would
% ever catch a letter that went into the stick upside down.
%
% Every irregularity below is deliberate and is registered in IMPRESSION.md,
% with the page it falls on and the reason it is there. Do not correct one
% without striking it from that register. They are sparse on purpose: a
% reader who notices the second turned letter has stopped reading evidence
% and started reading a trick.
% ---------------------------------------------------------------------------
\RequirePackage{color}

% --- Folios -----------------------------------------------------------------
% Oldstyle figures throughout the folios and the apparatus. A fount cut for
% a book of text has ranging figures only as an afterthought; the archivist's
% presses did not have the afterthought.
\makeatletter
\newcommand{\folio}{\if@mainmatter\oldstylenums{\thepage}\else\thepage\fi}
\makeatother

% --- The binder's mark ------------------------------------------------------
% Gathered in eights: sixteen pages to the sheet, folded three times, and the
% first four rectos of each gathering signed so that the binder can fold and
% collate it and so that an Officer comparing a copy under Article 21,
% Section 7 can see at once that no gathering is wanting. The preliminaries
% are gathering A and go unsigned, as preliminaries are set last and signed
% by nobody; the body opens at B.
%
% I is used and J, U and W are passed over, which is the old practice and
% survived into every printing house that kept one.
%
% \numexpr rounds where a compositor would not, so the arithmetic runs in
% count registers, which truncate.
\makeatletter
\newcount\pact@page
\newcount\pact@gathering
\newcount\pact@leaf
\newcommand*{\pact@sigletter}[1]{%
  \ifcase#1 \or A\or B\or C\or D\or E\or F\or G\or H\or I\or K\or L\or M\or
  N\or O\or P\or Q\or R\or S\or T\or V\or X\or Y\or Z\fi}
\newcommand{\pact@signature}{%
  \if@mainmatter
    \ifodd\c@page
      \pact@page=\c@page \advance\pact@page by \m@ne
      \pact@gathering=\pact@page \divide\pact@gathering by 16
      \pact@leaf=\pact@gathering \multiply\pact@leaf by 16
      \advance\pact@page by -\pact@leaf
      \pact@leaf=\pact@page \divide\pact@leaf by 2 \advance\pact@leaf by \@ne
      \ifnum\pact@leaf<5
        {\footnotesize\pact@sigletter{\numexpr\pact@gathering+2\relax}%
         \ifnum\pact@leaf>\@ne\oldstylenums{\number\pact@leaf}\fi}%
      \fi
    \fi
  \fi}

% --- Press figures ----------------------------------------------------------
% The numeral a pressman set at the foot of a forme so that the warehouse
% could tell whose work it was and pay him for it. It appears on some pages
% of a sheet and not on others, and which pages is nobody's business but his.
% Eight in the whole book. Pinned to folios, so they are set last of all --
% anything that repaginates the book moves them off their formes.
\newcommand{\pact@pressfig}[2]{\ifnum\c@page=#1 {\footnotesize\oldstylenums{#2}}\fi}
\newcommand{\pact@pressfigure}{%
  \pact@pressfigures}
\newcommand{\pact@pressfigures}{%
  \pact@pressfig{23}{2}\pact@pressfig{58}{4}\pact@pressfig{76}{1}%
  \pact@pressfig{109}{4}\pact@pressfig{134}{2}\pact@pressfig{167}{3}%
  \pact@pressfig{194}{4}\pact@pressfig{221}{1}}
\makeatother

% An Article opens on a page of its own, and book.cls gives that page the
% plain style: no running head, and the folio dropped to the foot. The mark
% and the figure belong on it as much as on any other, and the signature
% stands off to the left of the drop folio rather than under it.
\makeatletter
\def\ps@plain{%
  \let\@mkboth\@gobbletwo
  \let\@oddhead\@empty \let\@evenhead\@empty
  \def\@oddfoot{\reset@font\rlap{\pact@signature}%
    \hfil{\footnotesize\folio}\hfil\llap{\pact@pressfigure}}%
  \def\@evenfoot{\reset@font\rlap{\pact@pressfigure}%
    \hfil{\footnotesize\folio}\hfil}%
}
\makeatother

% --- Accidents of composition ----------------------------------------------
% Five in two hundred and forty-three pages, clustered in two gatherings,
% because a forme was set by one man on one day and his bad days are not
% distributed evenly through a book. Scattered one to a gathering they would
% read as decoration.

% A sort that went into the stick upside down. The commonest error in the
% trade. Used here in its quiet form: the compositor's hand went to the wrong
% box and came back with a q, and he set it turned, so that it prints a
% passable b. The word is spelt right and only the letter is wrong, which is
% why the four boxes b, d, p and q are kept apart in the case.
%
% An n turned to stand for a u was tried first and is useless: in this face
% the two are indistinguishable when either is turned, so the accident leaves
% no mark at all. b and q differ in their serifs and in the weight of the
% bowl, and the difference survives at reading size.
%
% #1 is the sort that was in the stick; #2 is the letter it stands for, set
% in white beneath it so that the text underneath the page stays correct and
% a reader can still search for the word.
\newcommand{\turnedsort}[2]{%
  \makebox[0pt][l]{\textcolor[gray]{1}{#2}}\rotatebox[origin=c]{180}{#1}}

% A sort out of the wrong case: the same letter from a fount of another body,
% cast to a wider design and standing a little large in its line. Seven-point
% metal set on a ten-point line -- the x-height nearly matches, which is why
% the eye passes over it once and catches it the second time.
\font\pactwrongfount=rm-lmr7 at 10.8pt
\newcommand{\wrongfount}[1]{{\pactwrongfount #1}}

% A sort that did not seat square on the stone and took the impression high.
\newcommand{\highsort}[1]{\raisebox{1.3pt}{#1}}

% A ligature the compositor did not reach for, and set as two sorts instead.
\newcommand{\twosorts}[2]{#1\kern0.04em #2}

% A word the ball did not ink evenly, or that the frisket shaded. Kept close
% to the body colour: lighter than this and it stops reading as thin ink and
% starts reading as a second colour, deliberately applied.
\newcommand{\lightink}[1]{\textcolor[gray]{0.36}{#1}}

% --- Casting off ------------------------------------------------------------
% The compositor measured the copy against the sheets he had and guessed how
% much would fit. Where he guessed short he set the end of the Article close,
% to bring it into the sheet; where he guessed long he opened it out, to keep
% the next Article off a recto it had no business on. Two Articles show the
% guess, at their ends, which is where a bad cast-off always shows.
\newenvironment{setclose}{%
  \par\linespread{0.95}\selectfont
  \spaceskip=0.28em plus 0.11em minus 0.09em}{\par}
\newenvironment{setopen}{%
  \par\linespread{1.07}\selectfont
  \spaceskip=0.36em plus 0.60em minus 0.07em
  \tolerance=9999}{\par}

% ---------------------------------------------------------------------------
% The Table of Subjects.
%
% Article 21, Section 7 requires every printed copy to carry a table of the
% subjects of this Pact, entered against the Article and the Section where a
% subject is treated and not against the leaf on which it falls. These macros
% set it: two columns, and every reference driven off \ref so that renumbering
% an Article renumbers the table with it.
%
% The content is generated -- backmatter/subjects.tex, built by
% tools/mkindex.py from tools/subjects.tsv. Do not hand-edit the output.
% ---------------------------------------------------------------------------
\RequirePackage{multicol}

% A reference: Article and Section, joined by a point. The clerk's compact
% form, explained in the note at the head of the table.
\newcommand{\subjref}[2]{\oldstylenums{\ref{#1}}.\oldstylenums{\ref{#2}}}
\newcommand{\subjart}[1]{\oldstylenums{\ref{#1}}}
\newcommand{\subjsee}[1]{\emph{See} #1}
\newcommand{\subjseealso}[1]{\emph{See also} #1}

\newlength{\subjindent}
\setlength{\subjindent}{1em}

\newcommand{\subjectsopen}{%
  \begin{multicols}{2}%
  \footnotesize
  \raggedright
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0pt}%
  \frenchspacing}
\newcommand{\subjectsclose}{\end{multicols}}

% A letter division. Kept with what follows it: a letter stranded at the foot
% of a column is the one thing that would make the table look unmade.
\newcommand{\subjletter}[1]{%
  \par\penalty-200\vskip 7pt plus 2pt minus 1pt
  {\normalfont\scshape #1}\nobreak
  \par\nobreak\vskip 2pt\nobreak}

% A headword and its references. Hanging indent, so a run-over line sits
% clear of the next headword. A column would rather break here than inside an
% entry, and a headword keeps its first subentry with it; past that the run of
% subentries must be breakable, or a long one cannot be set at all.
\newcommand{\subjentry}[2]{%
  \par\penalty-100
  \begingroup
    \hangindent\subjindent \hangafter1
    #1\unskip
    \ifx\relax#2\relax\else, #2\fi\par\nobreak
  \endgroup}

% A subentry: one level in, and reluctant to part from the one above it.
\newcommand{\subjsub}[2]{%
  \begingroup
    \leftskip\subjindent
    \hangindent\subjindent \hangafter1
    \textendash\ #1\unskip
    \ifx\relax#2\relax\else, #2\fi\par\penalty 150
  \endgroup}

% ---------------------------------------------------------------------------
% Setting. No microtype on this install, and a 4.4in measure full of long
% words; loosen the paragraph breaker rather than leave rivers and overfull
% lines. Ragged bottoms besides: a code printed by a department does not
% stretch its pages to square them off.
% ---------------------------------------------------------------------------
\setlength{\emergencystretch}{1em}
\tolerance=1500
\raggedbottom

% Table entries for Articles in small caps rather than bold: the only bold
% left in the book was in its contents, which is a publisher's habit and not
% a department's.
\makeatletter
\renewcommand*\l@chapter[2]{%
  \ifnum \c@tocdepth >\m@ne
    \addpenalty{-\@highpenalty}%
    \vskip 1.0em \@plus\p@
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode \scshape
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil
      \nobreak\hb@xt@\@pnumwidth{\hss\oldstylenums{#2}\kern-\p@\kern\p@}\par
      \penalty\@highpenalty
    \endgroup
  \fi}
\makeatother

% Section entries in the contents carry oldstyle folios too; book.cls's own
% definition, with the page number wrapped.
\makeatletter
\renewcommand*\l@section[2]{\@dottedtocline{1}{1.5em}{2.3em}{#1}{\oldstylenums{#2}}}
\makeatother

% ---------------------------------------------------------------------------
% The title page.
%
% Letterspacing, which no package here provides: \spaced{<track>}{<TEXT>}
% walks the tokens and sets a kern after each. Words are divided with
% \wordgap rather than with a space, because the token loop swallows spaces.
% ---------------------------------------------------------------------------
\makeatletter
\newcommand{\wordgap}{\kern0.30em}
\newcommand{\spaced}[2]{{\@tfor\pact@sp@c:=#2\do{\pact@sp@c\kern#1}\unkern}}
\makeatother

% The emblem: twelve citizens hand in hand, their heads outward and their
% feet meeting at the centre, enclosed by a line that runs round them at two
% radii and steps between the two with a square corner, twice.
%
% It is drawn in raw PDF path operators because this machine has no tikz, no
% pict2e and no metafont. The operators below are produced by
% tools/mkemblem.py, which carries the measurements and the reasoning; edit
% that script and paste its output here rather than editing this line.
%
% \siloemblem{<width>} sets it on a line of its own, centred on the measure
% and scaled to the width given. The ink as drawn is 85.2pt wide and 94.7pt
% tall, and its centre stands 4.25pt right of the origin, because the line
